generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("STORAGE_POSTGRES_PRISMA_URL")
}

model Human {
  id           String        @id @default(uuid())
  handle       String        @unique
  displayName  String
  publicKey    String
  endpointUrl  String
  clerkUserId  String?
  createdAt    DateTime      @default(now())

  // Agent type & doctor-specific fields
  agentType            String   @default("patient")  // "doctor" | "patient"
  specialty            String?                        // e.g. "Internal Medicine"
  clinicName           String?
  doctorCalendarEmail  String?                        // doctor's Google email for service account

  // Agent configuration
  personaPrompt        String?
  llmProvider          String   @default("claude")
  anomalyThresholdJson String   @default("{\"urgent\":85,\"soon\":70}")

  // HeyGen avatar
  heygenAvatarId String?
  avatarPhotoUrl String?

  // Google Calendar OAuth tokens (JSON blob)
  googleCalendarTokens String?

  capabilities  Capability[]
  policies      Policy[]
  calendar      CalendarEvent[]
  healthMetrics HealthMetric[]
  anomalyAlerts      AnomalyAlert[]
  healthExtractions  HealthExtraction[]
}

model Capability {
  id               String @id @default(uuid())
  humanId          String
  name             String
  description      String
  inputSchemaJson  String @default("{}")
  outputSchemaJson String @default("{}")
  human            Human  @relation(fields: [humanId], references: [id])
}

model Policy {
  id                String  @id @default(uuid())
  humanId           String
  capabilityName    String
  allowedCallersJson String @default("[\"*\"]")
  requiredScopesJson String @default("[]")
  paymentRequired   Boolean @default(false)
  priceCents        Int     @default(0)
  human             Human   @relation(fields: [humanId], references: [id])
}

model CalendarEvent {
  id            String  @id @default(uuid())
  humanId       String
  startTs       String
  endTs         String
  title         String
  googleEventId String?
  source        String  @default("local")
  human         Human   @relation(fields: [humanId], references: [id])
}

model HealthMetric {
  id            String  @id @default(uuid())
  humanId       String
  date          String
  sleepHours    Float
  steps         Int
  medAdherence  Boolean
  symptomScore  Float
  human         Human   @relation(fields: [humanId], references: [id])
}

model Booking {
  id         String   @id @default(uuid())
  fromHandle String
  toHandle   String
  startTs    String
  endTs      String
  title      String
  createdAt  DateTime @default(now())
}

model Trace {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  provider  String
  stepsJson String   @default("[]")
}

model AnomalyAlert {
  id                String    @id @default(uuid())
  humanId           String
  traceId           String?
  severity          String
  anomalyScore      Int
  flagsJson         String    @default("[]")
  decisionJson      String    @default("{}")
  evidenceJson      String?
  triageOutcomeJson String?
  status            String    @default("active")
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?
  human             Human     @relation(fields: [humanId], references: [id])
}

model AgentConversation {
  id         String         @id @default(uuid())
  agentType  String         // "secretary", "health_anomaly", "triage", "scheduler"
  userHandle String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  messages           AgentMessage[]
  healthExtractions  HealthExtraction[]

  @@unique([agentType, userHandle])
}

model AgentMessage {
  id             String            @id @default(uuid())
  conversationId String
  role           String            // "user", "assistant", "tool_call", "tool_result"
  content        String
  metadataJson   String            @default("{}")
  createdAt      DateTime          @default(now())
  conversation   AgentConversation @relation(fields: [conversationId], references: [id])
}

model HealthExtraction {
  id              String   @id @default(uuid())
  humanId         String
  conversationId  String
  category        String   // sleep | symptoms | medication | vitals | mood | diet | exercise | doctor_visit | other
  rawContent      String   // exact text from the conversation containing the health mention
  summary         String   // LLM-generated concise summary
  structuredData  String   @default("{}")  // JSON for numeric values e.g. {"systolic":140,"diastolic":90}
  mentionedDate   String?  // ISO date of when the health event occurred, if stated
  confidence      Float    // 0.0–1.0
  extractedAt     DateTime @default(now())

  human           Human             @relation(fields: [humanId], references: [id])
  conversation    AgentConversation @relation(fields: [conversationId], references: [id])

  @@index([humanId])
  @@index([humanId, category])
}

// ── iOS HealthKit upload tables ─────────────────────────────────────
// These tables are written to via the Supabase client (not Prisma),
// so IDs must use dbgenerated() for database-level UUID defaults.

model HealthUpload {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId   String   @map("device_id")
  exportDate DateTime @map("export_date")
  createdAt  DateTime @default(now()) @map("created_at")

  steps        Step[]
  heartRates   HeartRate[]
  sleepSamples SleepSample[]
  activeEnergy ActiveEnergy[]
  distances    Distance[]
  workouts     Workout[]
  weights      Weight[]
  heights      Height[]
  healthEvents HealthEvent[]

  @@map("health_uploads")
}

model Step {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploadId  String   @map("upload_id") @db.Uuid
  date      DateTime
  stepCount Float    @map("step_count")

  upload HealthUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([date])
  @@map("steps")
}

model HeartRate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploadId  String   @map("upload_id") @db.Uuid
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  bpm       Float

  upload HealthUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([startDate])
  @@map("heart_rates")
}

model SleepSample {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploadId   String   @map("upload_id") @db.Uuid
  startDate  DateTime @map("start_date")
  endDate    DateTime @map("end_date")
  sleepStage String   @map("sleep_stage")

  upload HealthUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([startDate])
  @@map("sleep_samples")
}

model ActiveEnergy {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploadId     String   @map("upload_id") @db.Uuid
  date         DateTime
  kilocalories Float

  upload HealthUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@map("active_energy")
}

model Distance {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploadId       String   @map("upload_id") @db.Uuid
  date           DateTime
  distanceMeters Float    @map("distance_meters")

  upload HealthUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@map("distances")
}

model Workout {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploadId            String   @map("upload_id") @db.Uuid
  startDate           DateTime @map("start_date")
  endDate             DateTime @map("end_date")
  activityType        String   @map("activity_type")
  durationSeconds     Float    @map("duration_seconds")
  totalEnergyKcal     Float?   @map("total_energy_kcal")
  totalDistanceMeters Float?   @map("total_distance_meters")

  upload HealthUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([startDate])
  @@map("workouts")
}

model Weight {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploadId String   @map("upload_id") @db.Uuid
  date     DateTime
  weightKg Float    @map("weight_kg")

  upload HealthUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@map("weights")
}

model Height {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploadId String   @map("upload_id") @db.Uuid
  date     DateTime
  heightCm Float    @map("height_cm")

  upload HealthUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@map("heights")
}

model HealthEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploadId  String   @map("upload_id") @db.Uuid
  eventType String   @map("event_type")
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  upload HealthUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@map("health_events")
}
