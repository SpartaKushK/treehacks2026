# Database (Supabase Postgres) — set in Vercel for production
# Format: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.mavwwlayckncyednpids.supabase.co:5432/postgres?sslmode=require

# Supabase (for direct queries and apps/api service)
SUPABASE_URL=https://mavwwlayckncyednpids.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# LLM providers (optional — app runs with deterministic fallbacks)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Note: The app now uses the class-based hierarchical agent architecture by default
# (PlannerAgent with HealthAgent and SchedulerAgent sub-agents)
# Legacy Secretary agent is deprecated - see lib/agents/ for new architecture

# Base URL for local development (used by demo orchestration)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Clerk route config
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Doctor Agent (Python microservice — runs on port 8000 by default)
DOCTOR_AGENT_URL=http://localhost:8000
