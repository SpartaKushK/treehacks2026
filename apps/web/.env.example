# Supabase (auto-populated by Vercel integration)
STORAGE_POSTGRES_PRISMA_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
STORAGE_POSTGRES_URL_NON_POOLING=postgres://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require
STORAGE_SUPABASE_URL=https://PROJECT_REF.supabase.co
STORAGE_SUPABASE_SERVICE_ROLE_KEY=

# LLM providers (optional — app runs with deterministic fallbacks)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Base URL for local development (used by demo orchestration)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Clerk route config
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Doctor Agent (Python microservice — runs on port 8000 by default)
DOCTOR_AGENT_URL=http://localhost:8000
