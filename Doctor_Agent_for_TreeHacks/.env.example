# ─── Required ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# ─── Doctor Identity ──────────────────────────────────────────────────────────
DOCTOR_NAME=Dr. Sarah Chen
DOCTOR_ID=dr_001
DOCTOR_EMAIL=doctor@example.com
# With service account: use the calendar ID you shared with the service account
# (e.g. your Gmail address like you@gmail.com, or the calendar ID from Calendar settings).
DOCTOR_CALENDAR_ID=doctor@example.com

# ─── Google Calendar (pick one; no sign-in again after setup) ───────────────────
# Option A: Service account — put the JSON key file in credentials/ and share the
# doctor's calendar with the service account email (see GOOGLE_SETUP.md).
# Path is relative to the Doctor_Agent_for_TreeHacks folder.
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
# Option B: OAuth — doctor signs in once (e.g. Next.js Connect Google Calendar); paste refresh_token here
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
# GOOGLE_REFRESH_TOKEN=1//0abc...paste-after-one-time-oauth-flow

# ─── This Server ──────────────────────────────────────────────────────────────
DOCTOR_AGENT_BASE_URL=http://localhost:8000

# ─── Optional: Email (for sending forms) ──────────────────────────────────────
SENDGRID_API_KEY=SG.REPLACE_ME
FROM_EMAIL=noreply@yourclinic.com
